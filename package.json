{
  "name": "@forteadvice/design-tokens",
  "version": "0.6.0",
  "description": "Shared design tokens for all Forte Advice products",
  "type": "module",
  "main": "./dist/ts/tokens.js",
  "types": "./dist/ts/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/tokens.d.ts",
      "default": "./dist/ts/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./shadcn": "./dist/css/shadcn.css",
    "./theme": "./dist/css/theme.css",
    "./tailwind": "./dist/tailwind/preset.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/validate.js",
    "validate:pptx": "python3 scripts/validate-pptx.py",
    "prebuild": "node scripts/validate.js"
  },
  "files": [
    "dist",
    "tokens.json",
    "assets"
  ],
